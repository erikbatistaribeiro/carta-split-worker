{
  "name": "carta-split-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker para gerar Carta de Autorização Split de Pagamento",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
